{
  "name": "technical-challenge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Financial risk score API",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "clean:tests": "node -e \"require('node:fs').rmSync('dist-tests', { recursive: true, force: true })\"",
    "build:tests": "npm run clean:tests && esbuild \"tests/**/*.test.ts\" --bundle --platform=node --format=esm --packages=external --outbase=tests --outdir=dist-tests",
    "test": "npm run typecheck && npm run build:tests && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
